[submodule "Zsign"]
	path = Zsign
	url = https://github.com/claration/Zsign-Package.git
	# The SwiftPM layout (Package.swift + swift/) only exists on `package`;
	# the default branch is the bare C++ project and cannot be built here.
	branch = package
[submodule "IDeviceKitten"]
	path = IDeviceKitten
	url = https://github.com/claration/IDeviceKit.git
